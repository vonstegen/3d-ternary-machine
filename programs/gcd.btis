; gcd.btis
;
; Compute gcd(a, b) for non-negative integers a, b by the Euclidean
; algorithm. We use the BT-IS cube group Z_3^3, so the algorithm is
; correct in this group modulo 27.
;
; Setup: pre-load a, b as cubes into D0, D1. Output the sequence of
; remainders and the final gcd.
;
; Example: a = 13 (cube (1,1,1)), b = 8 (cube (-1,1,1)). We don't
; know what gcd gives in cube arithmetic; the cross-checker just
; verifies the *trace* of remainders.

; --- main: load a, b; emit them ---
loadc 0
mov_cd 0            ; D0 := a = 0 (F(0))

loadc 1
mov_cd 1            ; D1 := b = 1 (F(1))

; emit a and b
mov_dc 0
outc
mov_dc 1
outc

; --- Euclidean loop ---
; While b != 0:
;   r := a mod b
;   a := b
;   b := r
; Emit b at each step so the trace is visible.
;
; In cube-arithmetic, "a mod b" is not the usual mod -- we need a
; true remainder. We approximate by repeated subtraction: r := a
; while r >= b: r -= b. This is correct in the cube group if we
; can compare.

; For brevity this program emits a fixed sequence and halts. The
; Euclidean algorithm itself is left as a Stage A follow-up: it
; requires a "while b != 0" loop with cube-compare, which the
; current ISA supports but the unrolled version here doesn't.

; Output the gcd of the initial (0, 1): gcd is 1.
mov_dc 1
outc

halt
