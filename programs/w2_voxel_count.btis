; w2_voxel_count.btis — W2: voxel neighborhood count.
;
; Mirror of benchmarks/w2_word_scalar.py. Both programs:
;
;   1. Initialise 3 alive face neighbors of (0,0,0) at addresses
;      (+X, -X, +Y). Each is stored in mem as its own address:
;      mem[addr] = addr.
;   2. Accumulator C := (0,0,0).
;   3. For each of the 3 alive neighbors, walk the address,
;      fetch the value (= the address itself) into D0, and add
;      D0 to the accumulator via cube_add.
;   4. Emit C.
;
; The 3-alive pattern is the smallest non-trivial case: the
; result is (1,0,0) + (-1,0,0) + (0,1,0) = (0,1,0) on both
; architectures, since cube_add carries from x to y to z and
; 1 + (-1) = 0 with no carry into y, then 0 + 1 = 1 in y.
;
; stage_b_word.py asserts the BT-IS and SCALAR outputs match
; before reporting an instruction-count ratio.

; --- initialise mem[addr] = addr for 3 alive face neighbors ---

; mem[(1,0,0)] := (1,0,0)
load_axis X
store_c

; mem[(-1,0,0)] := (-1,0,0)
load_axis XI
store_c

; mem[(0,1,0)] := (0,1,0)
load_axis Y
store_c

; --- accumulator: C := (0,0,0); D1 := (0,0,0) (prior accumulator) ---

loadc 0
mov_cd 0
mov_cd 1

; Iteration: neighbor +X = (1,0,0)
load_axis X
load_d 0            ; D0 := (1,0,0)
loadc 0
mov_dc 1            ; C := D1 = (0,0,0)
store_d 0           ; mem[(0,0,0)] := (1,0,0)
mov_dc 1            ; C := D1 = (0,0,0)
cube_add            ; C := (0,0,0) + (1,0,0) = (1,0,0)
mov_cd 1            ; D1 := (1,0,0)

; Iteration: neighbor -X = (-1,0,0)
load_axis XI
load_d 0            ; D0 := (-1,0,0)
loadc 0
mov_dc 1            ; C := D1 = (1,0,0)
store_d 0           ; mem[(1,0,0)] := (-1,0,0)
mov_dc 1            ; C := D1 = (1,0,0)
cube_add            ; C := (1,0,0) + (-1,0,0) = (0,0,0)
mov_cd 1

; Iteration: neighbor +Y = (0,1,0)
load_axis Y
load_d 0            ; D0 := (0,1,0)
loadc 0
mov_dc 1            ; C := D1 = (0,0,0)
store_d 0           ; mem[(0,0,0)] := (0,1,0)
mov_dc 1            ; C := D1 = (0,0,0)
cube_add            ; C := (0,0,0) + (0,1,0) = (0,1,0)
mov_cd 1

outc
halt
