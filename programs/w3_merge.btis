; w3_merge.btis — three-way compare with branches.
;
; Compare two cubes (1,0,0) and (0,1,0); route to one of three
; labels based on lex order.

load_axis X
mov_cd 0
load_axis Y
mov_cd 1
; We compare D0 with D1 by lex order: compare .x, then .y, then .z.

; Step 1: compare .x
mov_dc 1            ; C := D1 = (0,1,0)
mov_cd 2            ; D2 := (0,1,0)  (save)
mov_dc 0            ; C := D0 = (1,0,0)
mov_cd 3            ; D3 := (1,0,0)  (save)
mov_dc 2            ; C := D2 = (0,1,0)
mov_dc 0            ; C := D0
; Compare D0.x vs D1.x by checking D0.x vs 0 (since D1.x=0).
; We do: CMP 0 on D0.x.
; If D0.x > 0: D0 wins.
; If D0.x < 0: D1 wins.
; If D0.x == 0: tie, check .y.
mov_dc 0
cmp 0               ; F = sign(C.x - 0)
br_pos gt_x
br_neg lt_x
br_zero eq_x
halt

label gt_x
mov_dc 0
outc
halt

label lt_x
mov_dc 1
outc
halt

label eq_x
; Tie on .x: compare .y.
mov_dc 3            ; C := D3 = (1,0,0)
mov_cd 0            ; D0 := (1,0,0)  (save)
mov_dc 2            ; C := D2 = (0,1,0)
mov_cd 1            ; D1 := (0,1,0)  (save)
mov_dc 0            ; C := D0 = (1,0,0)
cmp 0
br_pos gt_y
br_neg lt_y
br_zero eq_y
halt

label gt_y
mov_dc 0
outc
halt

label lt_y
mov_dc 1
outc
halt

label eq_y
; Tie on .y and .x: compare .z (always 0 here).
mov_dc 0
mov_cd 1
mov_dc 0
outc
halt
